{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ArmyBuffSettings.json",
  "title": "ArmyBuffSettings",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "Id": {
        "type": "integer",
        "minimum": 1011,
        "maximum": 2004
      },
      "Name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 6
      },
      "Type": {
        "type": "integer",
        "minimum": 1,
        "maximum": 66
      },
      "Level": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5,
        "enum": [
          1,
          2,
          3,
          4,
          5
        ]
      },
      "Value": {
        "type": "integer",
        "minimum": 0,
        "maximum": 300
      },
      "Debuff": {
        "type": "boolean"
      },
      "Trigger": {
        "type": "boolean"
      },
      "Hide": {
        "type": "boolean"
      }
    },
    "required": [
      "Id",
      "Name",
      "Type",
      "Level",
      "Value",
      "Debuff",
      "Trigger",
      "Hide"
    ],
    "additionalProperties": false
  }
}
