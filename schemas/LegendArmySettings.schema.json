{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "LegendArmySettings.json",
  "title": "LegendArmySettings",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "Id": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6,
        "enum": [
          1,
          2,
          3,
          4,
          5,
          6
        ]
      },
      "Name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 5,
        "enum": [
          "勒克莱尔师",
          "塔曼旅",
          "幽灵师",
          "沙漠之鼠",
          "矛头",
          "闪电师"
        ]
      },
      "TacticsSet": {
        "type": "array",
        "minItems": 4,
        "maxItems": 6
      },
      "Army": {
        "type": "array",
        "minItems": 10,
        "maxItems": 13
      },
      "MaxUnit": {
        "type": "integer",
        "minimum": 6,
        "maximum": 6,
        "enum": [
          6
        ]
      },
      "MaxAssignment": {
        "type": "integer",
        "minimum": 10,
        "maximum": 10,
        "enum": [
          10
        ]
      },
      "Country": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3
      }
    },
    "required": [
      "Id",
      "Name",
      "TacticsSet",
      "Army",
      "MaxUnit",
      "MaxAssignment",
      "Country"
    ],
    "additionalProperties": false
  }
}
