{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GeneralNameSettings.json",
  "title": "GeneralNameSettings",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "Id": {
        "type": "integer",
        "minimum": 1,
        "maximum": 155
      },
      "EName": {
        "type": "string",
        "minLength": 3,
        "maxLength": 12
      },
      "CountryId": {
        "type": "integer",
        "minimum": 1,
        "maximum": 46
      },
      "ArmySeries": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3
      }
    },
    "required": [
      "Id",
      "EName",
      "CountryId",
      "ArmySeries"
    ],
    "additionalProperties": false
  }
}
