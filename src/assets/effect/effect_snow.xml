<effect name="snow">	
	<emitter name="fire" life="2.0">
		<param name="settings" mode="cont" type="area" width="1024" height="768"/>
		<param name="image" file="star.png" blend="add" width="20" height="20"/>	
		<param name="life" min="1.8" max="1.8"/>
		<param name="angle" min="100.0" max="120.0"/>
		<param name="rotangle" type="random" min="0.0" max="0.0"/>
		<param name="speed" min="140.0" max="250.0"/>
		<param name="gravity" min="0.0" max="0.0"/>
		<param name="scale" min="0.2" max="1.0"/>
		<param name="rotspeed" min="0.0" max="0.0"/>
		<param name="r" min="255" max="255"/>
		<param name="g" min="255" max="255"/>
		<param name="b" min="255" max="255"/>
		<param name="a" min="255" max="255"/>	
		<param name="timetrack">
			<track time="0.0" quantity="50.0"/>
		</param>
		<param name="lifetrack">
			<track life="0.0" speed="1.0" gravity="0.0" scale="1.0" rotspeed="1.0" r="1.0" g="1.0" b="1.0" a="1.0"/>
			<track life="0.8" speed="1.0" gravity="0.0" scale="1.0" rotspeed="1.0" r="1.0" g="1.0" b="1.0" a="1.0"/>
			<track life="1.0" speed="1.0" gravity="0.0" scale="1.0" rotspeed="1.0" r="1.0" g="1.0" b="1.0" a="0"/>
		</param>
	</emitter>
</effect>