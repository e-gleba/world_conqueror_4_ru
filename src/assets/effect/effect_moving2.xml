<effect name="firetrack">
	<emitter name="cloud" life="1.0">
		<param name="settings" mode="cont" type="area" width="20" height="20"/>
		<param name="image" file="cloud5.png" blend="alpha" width="40" height="40"/>
		<param name="life" min="0.5" max="0.8"/>
		<param name="angle" min="-90.0" max="90.0"/>
		<param name="rotangle" type="random" min="0.0" max="360.0"/>
		<param name="speed" min="20.0" max="25.0"/>
		<param name="gravity" min="-40.0" max="-20.0"/>
		<param name="scale" min="1.0" max="1.6"/>
		<param name="rotspeed" min="0.0" max="0.0"/>
		<param name="r" min="130" max="140"/>
		<param name="g" min="120" max="130"/>
		<param name="b" min="100" max="110"/>
		<param name="a" min="100" max="255"/>	
		<param name="timetrack">
			<track time="0.0" quantity="44.0"/>
		</param>
		<param name="lifetrack">
			<track life="0.0" speed="1.0" gravity="1.0" scale="0.5" rotspeed="0.5" r="1.0" g="1.0" b="1.0" a="0.7"/>
			<track life="1.0" speed="0.0" gravity="1.0" scale="1.5" rotspeed="0.5" r="1.0" g="1.0" b="1.0" a="0.0"/>
		</param>
	</emitter>
</effect>
