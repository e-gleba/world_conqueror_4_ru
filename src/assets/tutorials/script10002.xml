<script>
	<cmd name="rand seed" id="100"/>

	<!--关闭回合-->	
	<cmd name="wait enter scene" string="SceneRoundTurn"/>	
	<cmd name="draw ui rect" string="btn_ok" w="0" h="0"/>
	<cmd name="wait ui" string="btn_ok"/>

  <!--教官说话-->	
	<cmd name="show text" commander="1037" textid="1011"/>
  <cmd name="wait close scene" string="SceneTalk"/>

	<!--士气上升或下降将直接关系到一个部队的战斗力，当部队被夹击或被包围时，会对士气造成很大的影响。-->
	<cmd name="show text" commander="1037" textid="1012"/>	
	<cmd name="wait close scene" string="SceneTalk"/>

  <cmd name="moveto area" gx="28" gy="16"/>
  <cmd name="wait area" gx="28" gy="16"/>

  <cmd name="moveto area" gx="28" gy="14"/>
  <cmd name="wait area" gx="28" gy="14"/>
  <cmd name="wait action"/>

  <cmd name="moveto area" gx="27" gy="14"/>
  <cmd name="wait area" gx="27" gy="14"/>
  <cmd name="wait action"/>
	<cmd name="wait return scene" string="SceneBattle"/>
	
	<!--查看士气低落buff-->
	<cmd name="moveto area" gx="27" gy="14"/>
	<cmd name="wait area" gx="27" gy="14"/>

	<cmd name="wait time" time="0.5"/>
	
	<cmd name="draw ui rect" string="btn_armybuff" repeater="rpt_army_buff" index="0"/>
	<cmd name="wait ui" string="btn_armybuff" repeater="rpt_army_buff" index="0"/>
	<cmd name="wait time" time="0.2"/>
	
	<cmd name="wait close scene" string="SceneArmyBuffTip"/>
	<cmd name="wait time" time="0.2"/>
	
	<!--如果部队陷入混乱，他将完全失去战斗力。-->
	<cmd name="show text" commander="1037" textid="1013"/>
	<cmd name="wait close scene" string="SceneTalk"/>

	<!--查看士气混乱buff-->
	<cmd name="moveto area" gx="30" gy="13"/>
	<cmd name="wait area" gx="30" gy="13"/>

	<cmd name="wait time" time="0.5"/>

	<cmd name="draw ui rect" string="btn_armybuff" repeater="rpt_army_buff" index="0"/>
	<cmd name="wait ui" string="btn_armybuff" repeater="rpt_army_buff" index="0"/>
	<cmd name="wait time" time="0.2"/>

	<cmd name="wait close scene" string="SceneArmyBuffTip"/>
	<cmd name="wait time" time="0.2"/>
	
  <cmd name="moveto area" gx="29" gy="15"/>
  <cmd name="wait area" gx="29" gy="15"/>

  <cmd name="moveto area" gx="30" gy="14"/>
  <cmd name="wait area" gx="30" gy="14"/>
  <cmd name="wait action"/>

  <cmd name="moveto area" gx="30" gy="13"/>
  <cmd name="wait area" gx="30" gy="13"/>
  <cmd name="wait action"/>
  <cmd name="wait return scene" string="SceneBattle"/>
 
  <cmd name="wait time" time="0.2"/>
  <cmd name="unsel area"/>

	<!--如果攻击击败了敌方单位，您的部队将不会受到反击。-->
	<cmd name="show text" commander="1037" textid="1014"/>
	<cmd name="wait close scene" string="SceneTalk"/>
	 
  <cmd name="moveto area" gx="26" gy="17"/>
  <cmd name="wait area" gx="26" gy="17"/>

  <cmd name="moveto area" gx="27" gy="15"/>
  <cmd name="wait area" gx="27" gy="15"/>
  <cmd name="wait action"/>

  <cmd name="moveto area" gx="27" gy="14"/>
  <cmd name="wait area" gx="27" gy="14"/>
  <cmd name="wait action"/>

  <cmd name="wait return scene" string="SceneBattle"/>

  
  <!--造防御设施-->
  <!--建造防御设施是抵挡进攻的有效手段，防御设施只能在自己领地建造，并且需要一定的时间才能完成。-->
  <cmd name="show text" commander="1037" textid="1015"/>
  <cmd name="wait close scene" string="SceneTalk"/>

  <cmd name="moveto area" gx="25" gy="15"/>
  <cmd name="wait area" gx="25" gy="15"/>
  <cmd name="wait time" time="0.2"/>

  <cmd name="draw ui rect" string="btn_defense"/>
  <cmd name="wait ui" string="btn_defense"/>

  <cmd name="wait enter scene" string="SceneBuildDefense"/>
  <cmd name="wait time" time="0.2"/>

  <cmd name="disable ui" string="btn_feat_1" repeater="rpt_armylist" index="0"/>
  <cmd name="disable ui" string="btn_feat_2" repeater="rpt_armylist" index="0"/>
  <cmd name="disable ui" string="btn_feat_3" repeater="rpt_armylist" index="0"/>

  <cmd name="disable scroll" string="sv_armylist"/>
  <cmd name="draw ui rect" string="btn_army_item" repeater="rpt_armylist" index="0"/>
  <cmd name="wait ui" string="btn_army_item" repeater="rpt_armylist" index="0"/>
  <cmd name="wait time" time="0.2"/>

  <cmd name="draw ui rect" string="btn_build"/>
  <cmd name="wait ui" string="btn_build"/>
  <cmd name="wait action"/>


  <!--造防空设施-->
  <!--防空设施能有效地减少空袭和导弹的伤害。-->
  <cmd name="show text" commander="1037" textid="1016"/>
  <cmd name="wait close scene" string="SceneTalk"/>

  <cmd name="moveto area" gx="27" gy="15"/>
  <cmd name="wait area" gx="27" gy="15"/>
  <cmd name="wait time" time="0.2"/>

  <cmd name="draw ui rect" string="btn_airdefense"/>
  <cmd name="wait ui" string="btn_airdefense"/>

  <cmd name="wait enter scene" string="SceneBuildDefense"/>
  <cmd name="wait time" time="0.2"/>

  <cmd name="disable ui" string="btn_feat_1" repeater="rpt_armylist" index="0"/>
  <cmd name="disable ui" string="btn_feat_2" repeater="rpt_armylist" index="0"/>
  <cmd name="disable ui" string="btn_feat_3" repeater="rpt_armylist" index="0"/>

  <cmd name="disable scroll" string="sv_armylist"/>
  <cmd name="draw ui rect" string="btn_army_item" repeater="rpt_armylist" index="0"/>
  <cmd name="wait ui" string="btn_army_item" repeater="rpt_armylist" index="0"/>
  <cmd name="wait time" time="0.2"/>

  <cmd name="draw ui rect" string="btn_build"/>
  <cmd name="wait ui" string="btn_build"/>
  <cmd name="wait action"/>

  <!--占领城市-->
  <cmd name="show text" commander="1037" textid="1017"/>
  <cmd name="wait close scene" string="SceneTalk"/>
	<cmd name="unsel area"/>
  <cmd name="moveto area" gx="23" gy="17"/>
  <cmd name="wait area" gx="23" gy="17"/>

  <cmd name="moveto area" gx="21" gy="16"/>
  <cmd name="wait area" gx="21" gy="16"/>
  <cmd name="wait action"/>

  <cmd name="moveto area" gx="21" gy="15"/>
  <cmd name="wait area" gx="21" gy="15"/>
  <cmd name="wait action"/>
  <cmd name="wait return scene" string="SceneBattle"/>


  <cmd name="moveto area" gx="23" gy="16"/>
  <cmd name="wait area" gx="23" gy="16"/>

  <cmd name="moveto area" gx="21" gy="15"/>
  <cmd name="wait area" gx="21" gy="15"/>
  <cmd name="wait action"/>

  <!--建造地标建筑-->
  <cmd name="show text" commander="1037" textid="1018"/>
  <cmd name="wait close scene" string="SceneTalk"/>

  <cmd name="draw ui rect" string="btn_city"/>
  <cmd name="wait ui" string="btn_city"/>

  <cmd name="wait enter scene" string="SceneCity"/>
  <cmd name="wait time" time="0.2"/>

  <cmd name="draw ui rect" string="btn_city_landmark"/>
  <cmd name="wait ui" string="btn_city_landmark"/>

  <cmd name="wait enter scene" string="SceneCityFeature"/>
  <cmd name="wait time" time="0.2"/>

  <cmd name="draw ui rect" string="btn_feature" repeater="rpt_features" index="0"/>
  <cmd name="wait ui" string="btn_feature" repeater="rpt_features" index="0"/>
  <cmd name="wait time" time="0.2"/>

  <cmd name="draw ui rect" string="btn_build" parent="gb_tips"/>
  <cmd name="wait ui" string="btn_build" parent="gb_tips"/>
  <cmd name="wait time" time="0.2"/>

  <cmd name="draw ui rect" string="btn_close"/>
  <cmd name="wait ui" string="btn_close"/>
  <cmd name="wait return scene" string="SceneBattle"/>

  <!--您可以通过城市信息栏查看敌方的城市具体信息。-->
  <cmd name="show text" commander="1037" textid="1019"/>
  
  <cmd name="sel area" gx="21" gy="15"/>
  <cmd name="wait time" time="0.2"/>
  <cmd name="wait close scene" string="SceneTalk"/>

  <cmd name="draw ui rect" string="btn_city_feature_icon"/>
  <cmd name="wait ui" string="btn_city_feature_icon"/>
  <cmd name="wait time" time="0.2"/>

  <cmd name="wait close scene" string="SceneCityFeatureTip"/>
  <cmd name="wait time" time="0.2"/>

  <!--结束语-->
  <cmd name="show text" commander="1037" textid="1020"/>
  <cmd name="wait close scene" string="SceneTalk"/>

  <cmd name="clear rect"/>
  <cmd name="finish"/>
  
</script>


  


