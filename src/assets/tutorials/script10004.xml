<script>
	<cmd name="rand seed" id="100"/>
	<!--关闭回合-->	
	<cmd name="wait enter scene" string="SceneRoundTurn"/>	
	<cmd name="draw ui rect" string="btn_ok" w="0" h="0"/>
	<cmd name="wait ui" string="btn_ok"/>

	<!--教官说话-->	
	<!--大部分精英部队有主动技能，医疗兵可以使用技能治疗队友。-->
	<cmd name="show text" commander="1041" textid="1031"/>
	<cmd name="wait close scene" string="SceneTalk"/>

	<!--选中医疗兵-->
	<cmd name="moveto area" gx="6" gy="4"/>
	<cmd name="wait area" gx="6" gy="4"/>

	<cmd name="wait time" time="0.2"/>
	<cmd name="draw ui rect" string="btn_activefeature"/>
	<cmd name="wait ui" string="btn_activefeature"/>

	<cmd name="moveto area" gx="7" gy="3"/>
	<cmd name="wait area" gx="7" gy="3"/>
	<cmd name="wait action"/>

	<!--医疗兵占领绿圈-->
	<cmd name="moveto area" gx="6" gy="4"/>
	<cmd name="wait area" gx="6" gy="4"/>
	
	<cmd name="moveto area" gx="9" gy="4"/>
	<cmd name="wait area" gx="9" gy="4"/>
	<cmd name="wait action"/>
	
	<!--占领或消灭绿圈会触发一些事件或者解锁特定的技能学习（在HQ中学习）。-->
	<cmd name="show text" commander="1041" textid="1032"/>
	<cmd name="wait close scene" string="SceneTalk"/>

	<cmd name="unsel area"/>
	<cmd name="wait time" time="0.2"/>
	
	<!--选中工程兵-->
	<cmd name="moveto area" gx="9" gy="6"/>
	<cmd name="wait area" gx="9" gy="6"/>

	<cmd name="moveto area" gx="9" gy="5"/>
	<cmd name="wait area" gx="9" gy="5"/>
	<cmd name="wait action"/>

	<cmd name="wait time" time="0.2"/>
	<cmd name="draw ui rect" string="btn_activefeature2"/>
	<cmd name="wait ui" string="btn_activefeature2"/>

	<cmd name="moveto area" gx="6" gy="7"/>
	<cmd name="wait area" gx="6" gy="7"/>
	<cmd name="wait action"/>

	<!--工程部队挖掘的地道可以让步兵，和大部分装甲火炮通过，快速转移阵地。-->
	<cmd name="show text" commander="1041" textid="1033"/>
	<cmd name="wait close scene" string="SceneTalk"/>

	<!--通过地道时如果部队无法移动，能获得额外行动，每个地道触发次数有限。-->
	<cmd name="show text" commander="1041" textid="1034"/>
	<cmd name="wait close scene" string="SceneTalk"/>

	<!--再次选中工程兵-->
	<cmd name="moveto area" gx="9" gy="5"/>
	<cmd name="wait area" gx="9" gy="5"/>

	<!--穿隧道-->
	<cmd name="wait time" time="0.2"/>
	<cmd name="draw ui rect" string="btn_crosstunnel"/>
	<cmd name="wait ui" string="btn_crosstunnel"/>
	<cmd name="wait action"/>

	<cmd name="moveto area" gx="3" gy="7"/>
	<cmd name="wait area" gx="3" gy="7"/>
	<cmd name="wait action"/>

	<!--撤离-->
	<cmd name="wait time" time="0.2"/>
	<cmd name="unsel area"/>
	<cmd name="moveto area" gx="5" gy="6"/>
	<cmd name="wait area" gx="5" gy="6"/>

	<!--蓝色光圈代表撤离点，只有红圈关键目标可以在撤离点进行撤离。-->
	<cmd name="show text" commander="1041" textid="1035"/>
	<cmd name="wait close scene" string="SceneTalk"/>


	<cmd name="moveto area" gx="7" gy="4"/>
	<cmd name="wait area" gx="7" gy="4"/>
	<cmd name="wait action"/>

	<cmd name="moveto area" gx="9" gy="5"/>
	<cmd name="wait area" gx="9" gy="5"/>
	<cmd name="wait action"/>

	<!--穿隧道-->
	<cmd name="wait time" time="0.2"/>
	<cmd name="draw ui rect" string="btn_crosstunnel"/>
	<cmd name="wait ui" string="btn_crosstunnel"/>
	<cmd name="wait action"/>

	<!--指挥官阁下，请开始您的军事生涯，护送关键目标尽快撤离战场！-->
	<cmd name="show text" commander="1041" textid="1036"/>
	<cmd name="wait close scene" string="SceneTalk"/>
	
	<cmd name="finish"/>
</script>


  


