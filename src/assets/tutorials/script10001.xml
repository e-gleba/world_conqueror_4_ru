<script>
	<cmd name="rand seed" id="100"/>
	<!--关闭回合-->	
	<cmd name="wait enter scene" string="SceneRoundTurn"/>	
	<cmd name="draw ui rect" string="btn_ok" w="0" h="0"/>
	<cmd name="wait ui" string="btn_ok"/>

  
  
	<!--教官说话-->	
	<!--阁下，下面我来给您介绍下最基本的操作。-->	
	<cmd name="show text" commander="1018" textid="1001"/>
  <cmd name="wait close scene" string="SceneTalk"/>

	<!--转动的白圈表明这个部队仍然可以行动。-->
	<cmd name="show text" commander="1018" textid="1002"/>
	<cmd name="wait close scene" string="SceneTalk"/>

	<!--现在请选择部队，他们可以移动到闪烁的区域，红色光圈表示可以攻击的目标。-->	
	<cmd name="show text" commander="1018" textid="1003"/>	

	<cmd name="moveto area" gx="40" gy="12"/>	
	<cmd name="wait area" gx="40" gy="12"/>

	<cmd name="moveto area" gx="38" gy="12"/>	
	<cmd name="wait area" gx="38" gy="12"/>
	<cmd name="wait action"/>
	<cmd name="wait close scene" string="SceneTalk"/>	

	<cmd name="moveto area" gx="37" gy="11"/>
	<cmd name="wait area" gx="37" gy="11"/>
	<cmd name="wait action"/>
  <cmd name="wait return scene" string="SceneBattle"/>

	<!--不同的建筑可以生产不同的部队，高等级的建筑可以生产更高等级的部队。建造部队会消耗物资。-->	
	<cmd name="show text" commander="1018" textid="1004"/>
  <cmd name="wait close scene" string="SceneTalk"/>
	<cmd name="show text" commander="1018" textid="1005"/>
  
  <cmd name="moveto area" gx="40" gy="10"/>
  <cmd name="wait area" gx="40" gy="10"/>
  <cmd name="wait time" time="0.2"/>
  <cmd name="wait close scene" string="SceneTalk"/>	
  	
  <cmd name="draw ui rect" string="btn_recruitarmy"/>
  <cmd name="wait ui" string="btn_recruitarmy"/>

  <cmd name="wait enter scene" string="SceneBuildArmy"/>
  <cmd name="wait time" time="0.2"/>

  <cmd name="draw ui rect" string="btn_panzer"/>
  <cmd name="wait ui" string="btn_panzer"/>

  <cmd name="disable ui" string="btn_feat_1" repeater="rpt_armylist" index="0"/>
  <cmd name="disable ui" string="btn_feat_2" repeater="rpt_armylist" index="0"/>
  <cmd name="disable ui" string="btn_feat_3" repeater="rpt_armylist" index="0"/>

  <cmd name="disable scroll" string="sv_armylist"/>
  <cmd name="draw ui rect" string="btn_army_item" repeater="rpt_armylist" index="0"/>
  <cmd name="wait ui" string="btn_army_item" repeater="rpt_armylist" index="0"/>
  <cmd name="wait time" time="0.2"/>

  <cmd name="draw ui rect" string="btn_increase"/>
  <cmd name="wait ui" string="btn_increase"/>

  <cmd name="draw ui rect" string="btn_increase"/>
  <cmd name="wait ui" string="btn_increase"/>

  <cmd name="draw ui rect" string="btn_build"/>
  <cmd name="wait ui" string="btn_build"/>
  <cmd name="wait action"/>

  <!--学习上将-->
  <cmd name="add general" commander="1014"/>
  <cmd name="add general" commander="1020"/>
  <cmd name="add general" commander="1021"/>
  <cmd name="show text" commander="1018" textid="1006"/>
  <cmd name="wait close scene" string="SceneTalk"/>

  <cmd name="draw ui rect" string="btn_general"/>
  <cmd name="wait ui" string="btn_general"/>
  <cmd name="wait time" time="0.2"/>
  
  <cmd name="draw ui rect" string="btn_general" repeater="rpt_generals" index="2"/>
  <cmd name="wait ui" string="btn_general" repeater="rpt_generals" index="2"/>
  <cmd name="wait time" time="0.2"/>

  <cmd name="draw ui rect" string="btn_select_general" repeater="rpt_generals" index="2"/>
  <cmd name="wait ui" string="btn_select_general" repeater="rpt_generals" index="2"/>
  <cmd name="wait time" time="0.2"/>


  <!--学习回退-->

  <cmd name="moveto area" gx="41" gy="6"/>
  <cmd name="wait area" gx="41" gy="6"/>
  <cmd name="moveto area" gx="39" gy="5"/>
  <cmd name="wait area" gx="39" gy="5"/>
  <cmd name="wait action"/>

  <!--阁下，如果部队行动失误可以让他们立即返回。-->
  <cmd name="show text" commander="1018" textid="1007"/>
  <cmd name="wait close scene" string="SceneTalk"/>

  <cmd name="draw ui rect" string="btn_undo"/>
  <cmd name="wait ui" string="btn_undo"/>

  <cmd name="moveto area" gx="39" gy="6"/>
  <cmd name="wait area" gx="39" gy="6"/>
  <cmd name="wait action"/>

  <cmd name="moveto area" gx="38" gy="7"/>
  <cmd name="wait area" gx="38" gy="7"/>
  <cmd name="wait action"/>
  <cmd name="wait return scene" string="SceneBattle"/>

	<cmd name="show text" commander="1018" textid="1029"/>
	<cmd name="wait close scene" string="SceneTalk"/>
	
  <!--目标点-->
  <cmd name="moveto area" gx="35" gy="7"/>
  <cmd name="draw rect" gx="35" gy="7" x="-30" y="-30" w="60" h="60"/>
  
  <!--注意：这是一个关键据点，占领或者丢失这里将直接影响到战争的结果。-->	
  <cmd name="show text" commander="1018" textid="1008"/>
  <cmd name="wait close scene" string="SceneTalk"/>

  <cmd name="wait time" time="1"/>
  <cmd name="clear rect"/>
  
  <!--下一个回合-->
  <cmd name="show text" commander="1018" textid="1009"/>
  <cmd name="wait close scene" string="SceneTalk"/>
  <cmd name="draw ui rect" string="btn_end"/>
  <cmd name="wait ui" string="btn_end"/>
  <!--结束语-->
  <cmd name="show text" commander="1018" textid="1010"/>
  <cmd name="wait close scene" string="SceneTalk"/>
  
  <cmd name="finish"/>


  <cmd name="wait enter scene" string="SceneMessageBox"/>
  <cmd name="draw ui rect" string="btn_confirm"/>
  <cmd name="wait ui" string="btn_confirm"/>

 
  
  
</script>


  


