{
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "$comment": "Requires CMake 4.2+. Schema v10 (3.31/4.x). Upgrade $schema hash from cmake.org/cmake/help/v4.2 when IDE validation matters.",
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 0
    },
    "configurePresets": [
        {
            "$comment": "Base preset. apk_input empty = auto-download the pinned release APK (SHA-256 verified). Toggle patches with -DWC4_PATCH_<NAME>=OFF.",
            "name": "default",
            "displayName": "Default",
            "description": "Out-of-source build under build/ (Ninja)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "apk_input": {
                    "$comment": "Leave empty to auto-download original.apk from the pinned GitHub release",
                    "type": "FILEPATH",
                    "value": ""
                },
                "apk_input_sha256": {
                    "$comment": "Expected SHA-256 of apk_input — empty prints the actual hash without verifying",
                    "type": "STRING",
                    "value": ""
                },
                "deploy_variant": {
                    "$comment": "Variant installed by the deploy-* targets",
                    "type": "STRING",
                    "value": "ru_mod"
                },
                "adb_serial": {
                    "$comment": "adb device serial for deploy-adb — empty uses the default/only device",
                    "type": "STRING",
                    "value": ""
                }
            }
        }
    ],
    "buildPresets": [
        {
            "name": "decompile",
            "displayName": "State 1 — decompile",
            "description": "apktool d + decrypt JSON => pristine decompiled/",
            "configurePreset": "default",
            "targets": [
                "decompile"
            ]
        },
        {
            "name": "apks",
            "displayName": "State 2 — build APKs",
            "description": "Per variant: fresh copy + patches + encrypt + apktool b + sign",
            "configurePreset": "default",
            "targets": [
                "apks"
            ]
        },
        {
            "name": "deploy-waydroid",
            "displayName": "State 3 — deploy to Waydroid",
            "description": "Install deploy_variant via waydroid",
            "configurePreset": "default",
            "targets": [
                "deploy-waydroid"
            ]
        },
        {
            "name": "deploy-adb",
            "displayName": "State 3 — deploy via adb",
            "description": "Install deploy_variant via adb (set adb_serial to pick a device)",
            "configurePreset": "default",
            "targets": [
                "deploy-adb"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "displayName": "Patch tests",
            "description": "ctest patch validation — build the apks target first",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        }
    ],
    "workflowPresets": [
        {
            "$comment": "State 1: configure + decompile/decrypt only",
            "name": "configure",
            "displayName": "1 — configure",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "decompile"
                }
            ]
        },
        {
            "$comment": "State 2: full build — decompile (if needed) + all APK variants",
            "name": "build",
            "displayName": "2 — build",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "apks"
                }
            ]
        },
        {
            "$comment": "Build + ctest patch validation",
            "name": "test",
            "displayName": "build + test",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "apks"
                },
                {
                    "type": "test",
                    "name": "default"
                }
            ]
        },
        {
            "$comment": "State 3: build + install deploy_variant via waydroid",
            "name": "deploy-waydroid",
            "displayName": "3 — deploy (waydroid)",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "deploy-waydroid"
                }
            ]
        },
        {
            "$comment": "State 3: build + install deploy_variant via adb",
            "name": "deploy-adb",
            "displayName": "3 — deploy (adb)",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "deploy-adb"
                }
            ]
        }
    ]
}
