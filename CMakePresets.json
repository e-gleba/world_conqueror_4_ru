{
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "java_bin": {
                    "type": "FILEPATH",
                    "value": "java"
                }
            }
        }
    ],
    "buildPresets": [
        {
            "name": "update",
            "configurePreset": "default",
            "targets": [
                "update"
            ]
        },
        {
            "name": "patch",
            "configurePreset": "default",
            "targets": [
                "patch"
            ]
        },
        {
            "name": "deploy",
            "configurePreset": "default",
            "targets": [
                "deploy_and_run"
            ]
        }
    ]
}
