{
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "$comment": "Requires CMake 4.2+. Schema v10 (3.31/4.x). Upgrade $schema hash from cmake.org/cmake/help/v4.2 when IDE validation matters.",
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 0
    },
    "configurePresets": [
        {
            "$comment": "Base preset — inherit in all others. Override WC4_APK_INPUT to skip auto-download.",
            "name": "default",
            "displayName": "Default",
            "description": "Ninja, out-of-source under build/; all artifacts stay in build/",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "WC4_APK_INPUT": {
                    "$comment": "Leave empty to auto-download the base APK from GitHub releases",
                    "type": "FILEPATH",
                    "value": ""
                },
                "WC4_APK_SHA256": {
                    "$comment": "Pin the source APK hash; empty = record on first configure, then keep verifying",
                    "type": "STRING",
                    "value": ""
                },
                "WC4_VARIANTS": {
                    "$comment": "APK variants to build: localized, money, unlock_all",
                    "type": "STRING",
                    "value": "localized;money;unlock_all"
                },
                "WC4_DEPLOY_VARIANT": {
                    "$comment": "Variant installed by the deploy-* targets",
                    "type": "STRING",
                    "value": "unlock_all"
                },
                "WC4_JAVA": {
                    "type": "FILEPATH",
                    "value": "java"
                },
                "WC4_PYTHON": {
                    "type": "FILEPATH",
                    "value": "python3"
                },
                "WC4_ADB": {
                    "type": "FILEPATH",
                    "value": "adb"
                },
                "WC4_ADB_SERIAL": {
                    "$comment": "adb device serial for deploy-adb — empty uses the default/only device",
                    "type": "STRING",
                    "value": ""
                },
                "WC4_WAYDROID": {
                    "type": "FILEPATH",
                    "value": "waydroid"
                }
            }
        }
    ],
    "buildPresets": [
        {
            "name": "decompile",
            "displayName": "Stage 1 — decompile",
            "description": "apktool d + decrypt + sha256 manifest => build/decompiled/ (pristine)",
            "configurePreset": "default",
            "targets": [
                "decompile"
            ]
        },
        {
            "name": "apk",
            "displayName": "Stage 2 — patch & build",
            "description": "patched/ + every variant: patch, encrypt, apktool b, sign => build/dist/",
            "configurePreset": "default",
            "targets": [
                "apk"
            ]
        },
        {
            "name": "apk-localized",
            "displayName": "Build variant: localized",
            "description": "Base patches only — the clean RU build",
            "configurePreset": "default",
            "targets": [
                "apk-localized"
            ]
        },
        {
            "name": "apk-money",
            "displayName": "Build variant: money",
            "description": "Localized + economy mod (all costs 1, instant build, rich tutorial)",
            "configurePreset": "default",
            "targets": [
                "apk-money"
            ]
        },
        {
            "name": "apk-unlock-all",
            "displayName": "Build variant: unlock_all",
            "description": "Localized + full unlock (generals, stages, conquests, tech)",
            "configurePreset": "default",
            "targets": [
                "apk-unlock_all"
            ]
        },
        {
            "name": "verify",
            "displayName": "Verify tree manifests",
            "description": "Re-check the SHA-256 manifests of decompiled/ and patched/",
            "configurePreset": "default",
            "targets": [
                "verify"
            ]
        },
        {
            "name": "deploy-waydroid",
            "displayName": "Stage 3 — deploy to Waydroid",
            "description": "Install WC4_DEPLOY_VARIANT via waydroid",
            "configurePreset": "default",
            "targets": [
                "deploy-waydroid"
            ]
        },
        {
            "name": "deploy-adb",
            "displayName": "Stage 3 — deploy via adb",
            "description": "Install WC4_DEPLOY_VARIANT via adb (set WC4_ADB_SERIAL to pick a device)",
            "configurePreset": "default",
            "targets": [
                "deploy-adb"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "displayName": "Patch tests",
            "description": "ctest patch validation — build any apk target first",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        }
    ],
    "workflowPresets": [
        {
            "$comment": "Stage 1 only: configure once, then decompile + verify the pristine tree",
            "name": "prepare",
            "displayName": "Configure & decompile",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "decompile"
                }
            ]
        },
        {
            "$comment": "Stages 1-2: configure, decompile, patch & build all variants",
            "name": "build",
            "displayName": "Build all variants",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "apk"
                }
            ]
        },
        {
            "$comment": "Full pipeline: build + patch tests",
            "name": "release",
            "displayName": "Build and test",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "apk"
                },
                {
                    "type": "test",
                    "name": "default"
                }
            ]
        }
    ]
}
