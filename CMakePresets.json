{
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "$comment": "Requires CMake 4.2+. Schema v10 (3.31/4.x). Upgrade $schema hash from cmake.org/cmake/help/v4.2 when IDE validation matters.",
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 0
    },
    "configurePresets": [
        {
            "$comment": "Base preset — inherit in all others. Override apk_input to skip auto-download.",
            "name": "default",
            "displayName": "Default",
            "description": "Out-of-source build under build/",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "java_bin": {
                    "type": "FILEPATH",
                    "value": "java"
                },
                "python3_bin": {
                    "type": "FILEPATH",
                    "value": "python3"
                },
                "waydroid_bin": {
                    "type": "FILEPATH",
                    "value": "waydroid"
                },
                "adb_bin": {
                    "type": "FILEPATH",
                    "value": "adb"
                },
                "apk_input": {
                    "$comment": "Leave empty to auto-download original.apk from GitHub release",
                    "type": "FILEPATH",
                    "value": ""
                },
                "adb_serial": {
                    "$comment": "adb device serial for deploy-adb — empty uses the default/only device",
                    "type": "STRING",
                    "value": ""
                }
            }
        }
    ],
    "buildPresets": [
        {
            "name": "decompile",
            "displayName": "Decompile APK",
            "description": "apktool d + decrypt JSON (patches apply via the patches target)",
            "configurePreset": "default",
            "targets": [
                "decompile"
            ]
        },
        {
            "name": "patches",
            "displayName": "Apply patches",
            "description": "Install all patches/ into decompiled/ (per-patch: patch-<name>)",
            "configurePreset": "default",
            "targets": [
                "patches"
            ]
        },
        {
            "name": "build",
            "displayName": "Build APKs",
            "description": "Stage, encrypt, apktool b, sign — produces wc4_ru and wc4_ru_mod",
            "configurePreset": "default",
            "targets": [
                "build"
            ]
        },
        {
            "name": "deploy-waydroid",
            "displayName": "Deploy to Waydroid",
            "description": "Install both signed APKs via waydroid",
            "configurePreset": "default",
            "targets": [
                "deploy-waydroid"
            ]
        },
        {
            "name": "deploy-adb",
            "displayName": "Deploy via adb",
            "description": "Install both signed APKs via adb (set adb_serial to pick a device)",
            "configurePreset": "default",
            "targets": [
                "deploy-adb"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "displayName": "Patch tests",
            "description": "ctest patch validation — build the decompile + patches targets first",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        }
    ],
    "workflowPresets": [
        {
            "$comment": "Full pipeline: configure once, then build + deploy",
            "name": "release",
            "displayName": "Build and deploy",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "build"
                },
                {
                    "type": "build",
                    "name": "deploy-waydroid"
                }
            ]
        }
    ]
}
