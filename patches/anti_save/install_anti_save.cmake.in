# Install-time script for the anti_save patch (configured with @ONLY@).
# @WC4_TREE@ is the variant tree, passed to the patch as -DWC4_TREE=<tree>
# and baked in at configure time. @fragments@ holds the token-substituted
# smali fragments (configure_file from 1_4_28/*.smali.in).
execute_process(
    COMMAND "@Python3_EXECUTABLE@" "@CMAKE_CURRENT_SOURCE_DIR@/apply.py"
            --tree "@WC4_TREE@" --fragments "@fragments@"
    COMMAND_ERROR_IS_FATAL ANY)
