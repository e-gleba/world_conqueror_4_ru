# Install-time script for the enable_all patch (configured with @ONLY@).
# @VARS@ are baked at configure time; ${CMAKE_INSTALL_PREFIX} is left as a
# literal so it resolves at INSTALL time to the real prefix ExternalProject
# passes via -DCMAKE_INSTALL_PREFIX=<tree> (configure-time value is the
# /usr/local default — do NOT @-substitute it).
execute_process(
    COMMAND "@Python3_EXECUTABLE@" "@CMAKE_CURRENT_SOURCE_DIR@/wc4_unlock.py"
            "${CMAKE_INSTALL_PREFIX}/assets/data"
    COMMAND_ERROR_IS_FATAL ANY)
