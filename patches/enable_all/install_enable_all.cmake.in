# Install-time script for the enable_all patch (configured with @ONLY@).
# ${CMAKE_CURRENT_LIST_DIR} = the dir of THIS file at install time, which
# for a configured script is the build dir — so reference the payload via
# the configured source dir.
execute_process(
    COMMAND "@Python3_EXECUTABLE@" "@CMAKE_CURRENT_SOURCE_DIR@/wc4_unlock.py"
            "@CMAKE_INSTALL_PREFIX@/assets/data"
    COMMAND_ERROR_IS_FATAL ANY)
