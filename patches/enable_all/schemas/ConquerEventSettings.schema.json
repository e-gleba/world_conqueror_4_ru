      "Trigger": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9,
        "enum": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8,
          9
        ]
      },
      "TriggerValue": {
        "type": "array",
        "minItems": 0,
        "maxItems": 4
      },
      "Location": {
        "type": "array",
        "minItems": 0,
        "maxItems": 4
      },
      "Chance": {
        "type": "integer",
        "minimum": 20,
        "maximum": 100,
        "enum": [
          20,
          30,
          40,
          50,
          60,
          70,
          80,
          90,
          100
        ]
