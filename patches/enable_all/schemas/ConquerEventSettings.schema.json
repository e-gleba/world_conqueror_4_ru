{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ConquerEventSettings.json",
  "title": "ConquerEventSettings",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "Id": {
        "type": "integer",
        "minimum": 1,
        "maximum": 129
      },
      "ConquerId": {
        "type": "integer",
        "minimum": 5,
        "maximum": 8,
        "enum": [
          5,
          6,
          7,
          8
        ]
      },
      "EventBuffId1": {
        "type": "integer",
        "minimum": 2011,
        "maximum": 2371
      },
      "Round1": {
        "type": "integer",
        "minimum": -1,
        "maximum": 5,
        "enum": [
          -1,
          2,
          3,
          5
        ]
      },
      "CountryId1": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20
      },
      "EventBuffId2": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2361
      },
      "Round2": {
        "type": "integer",
        "minimum": -1,
        "maximum": 10,
        "enum": [
          -1,
          0,
          2,
          3,
          4,
          5,
          10
