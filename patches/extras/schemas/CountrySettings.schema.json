{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CountrySettings.json",
  "title": "CountrySettings",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "Id": {
        "type": "integer",
        "minimum": 1,
        "maximum": 60
      },
      "Name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 7
      },
      "Camp": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5,
        "enum": [
          1,
          2,
          5
        ]
      },
      "InfantryMod": {
        "type": "integer",
        "minimum": 0,
        "maximum": 30,
        "enum": [
          0,
          1,
          2,
          3,
          5,
          6,
          7,
          8,
          9,
          10,
          11,
          12,
          13,
          15,
          23,
          24,
          27,
          29,
          30
        ]
      },
      "ArmoredMod": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10,
        "enum": [
          0,
          1,
          2,
          3,
          5,
          6,
          7,
          10
        ]
      },
      "ArtilleryMod": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10,
        "enum": [
          0,
          1,
          2,
          3,
          5,
          6,
          7,
          10
        ]
      },
      "Logo": {
        "type": "integer",
        "minimum": 0,
        "maximum": 25,
        "enum": [
          0,
          1,
          2,
          3,
          5,
          6,
          7,
          8,
          9,
          10,
          11,
          13,
          23,
          24,
          25
        ]
      }
    },
    "required": [
      "Id",
      "Name",
      "Camp",
      "InfantryMod",
      "ArmoredMod",
      "ArtilleryMod",
      "Logo"
    ],
    "additionalProperties": false
  }
}
