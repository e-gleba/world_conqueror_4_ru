{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EventBuffSettings.json",
  "title": "EventBuffSettings",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "Id": {
        "type": "integer",
        "minimum": 101,
        "maximum": 2511
      },
      "Type": {
        "type": "integer",
        "minimum": 1,
        "maximum": 51
      },
      "Value": {
        "type": "integer",
        "minimum": 0,
        "maximum": 200,
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          8,
          10,
          15,
          20,
          25,
          30,
          50,
          65,
          80,
          100,
          200
        ]
      },
      "Round": {
        "type": "integer",
        "minimum": -1,
        "maximum": 3,
        "enum": [
          -1,
          0,
          2,
          3
        ]
      },
      "ArmyBuffs": {
        "type": "array",
        "minItems": 0,
        "maxItems": 2
      }
    },
    "required": [
      "Id",
      "Type",
      "Value",
      "Round",
      "ArmyBuffs"
    ],
    "additionalProperties": false
  }
}
