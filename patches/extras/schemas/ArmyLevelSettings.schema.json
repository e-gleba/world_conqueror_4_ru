{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ArmyLevelSettings.json",
  "title": "ArmyLevelSettings",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "Level": {
        "type": "integer",
        "minimum": -1,
        "maximum": 6,
        "enum": [
          -1,
          1,
          2,
          3,
          4,
          5,
          6
        ]
      },
      "AddHP": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "enum": [
          0,
          20,
          40,
          60,
          80,
          100
        ]
      },
      "AddAttack": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20,
        "enum": [
          0,
          4,
          8,
          12,
          16,
          20
        ]
      },
      "AddDefense": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10,
        "enum": [
          0,
          2,
          4,
          6,
          8,
          10
        ]
      },
      "NeedExp": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1600,
        "enum": [
          0,
          250,
          450,
          800,
          1200,
          1600
        ]
      }
    },
    "required": [
      "Level",
      "AddHP",
      "AddAttack",
      "AddDefense",
      "NeedExp"
    ],
    "additionalProperties": false
  }
}
