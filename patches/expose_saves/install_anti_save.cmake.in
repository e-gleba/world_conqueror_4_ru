# Install-time script for the anti_save patch (configured @ONLY@).
# @WC4_TREE@ is the variant tree, passed to the patch as -DWC4_TREE=<tree>
# and baked in at configure time.
execute_process(
    COMMAND "@Python3_EXECUTABLE@" "@CMAKE_CURRENT_SOURCE_DIR@/patch.py"
            --tree "@WC4_TREE@" --snippets "@CMAKE_CURRENT_BINARY_DIR@/smali"
    COMMAND_ERROR_IS_FATAL ANY)
